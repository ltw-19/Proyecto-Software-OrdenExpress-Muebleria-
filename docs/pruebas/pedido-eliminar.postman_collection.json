    {
      "name": "7. Consultar catalogo (GESTOR) para elegir un mueble con stock",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "// Se usa el mueble de MAS stock: la prueba registra 4 pedidos de 1 unidad y aprueba uno.",
              "var conStock = pm.response.json().filter(function (m) { return m.unidades >= 4; });",
              "conStock.sort(function (a, b) { return b.unidades - a.unidades; });",
              "pm.test(\"Hay un mueble con al menos 4 unidades\", function () {",
              "    pm.expect(conStock.length).to.be.at.least(1);",
              "});",
              "pm.collectionVariables.set(\"id_mueble\", conStock[0].id);",
              "pm.collectionVariables.set(\"stock_tras_aprobar\", conStock[0].unidades - 1);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token_gestor}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/muebles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "muebles"
          ]
        }
      }
    },
