    {
      "name": "8. Consultar carrito (CLIENTE A) - 200 con items y totales",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var carrito = pm.response.json();",
              "var idA = pm.collectionVariables.get(\"id_mueble\");",
              "var idB = pm.collectionVariables.get(\"id_mueble_2\");",
              "pm.test(\"Devuelve los 2 items con la cantidad elegida al anadir\", function () {",
              "    pm.expect(carrito.cantidadItems).to.eql(2);",
              "    var a = carrito.items.find(function (i) { return i.idMueble === idA; });",
              "    var b = carrito.items.find(function (i) { return i.idMueble === idB; });",
              "    pm.expect(a.cantidad).to.eql(2);",
              "    pm.expect(b.cantidad).to.eql(1);",
              "});",
              "pm.test(\"Cada item trae datos del mueble para mostrarlo\", function () {",
              "    carrito.items.forEach(function (i) {",
              "        [\"codigo\", \"nombre\", \"urlFoto\", \"precioUsd\", \"precioBs\", \"subtotalUsd\", \"subtotalBs\"].forEach(function (k) {",
              "            pm.expect(i).to.have.property(k);",
              "        });",
              "        pm.expect(i.disponible).to.be.a(\"boolean\");",
              "        pm.expect(i).to.not.have.property(\"unidades\");",
              "    });",
              "});",
              "pm.test(\"Subtotal = precio x cantidad y total = suma de subtotales (USD)\", function () {",
              "    var suma = 0;",
              "    carrito.items.forEach(function (i) {",
              "        pm.expect(i.subtotalUsd).to.be.closeTo(i.precioUsd * i.cantidad, 0.001);",
              "        suma += i.subtotalUsd;",
              "    });",
              "    pm.expect(carrito.totalUsd).to.be.closeTo(suma, 0.001);",
              "});",
              "pm.test(\"Total en Bs. calculado por el backend con la misma tasa\", function () {",
              "    var tasa = carrito.items[0].precioBs / carrito.items[0].precioUsd;",
              "    pm.expect(carrito.totalBs).to.be.closeTo(carrito.totalUsd * tasa, 0.02);",
              "});",
              "pm.collectionVariables.set(\"carrito_json\", JSON.stringify(carrito));"
            ],
            "type": "text/javascript"
          }
        }
