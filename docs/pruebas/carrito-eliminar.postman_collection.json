    {
      "name": "7. Eliminar mueble A del carrito - 200 con totales recalculados",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var carrito = pm.response.json();",
              "var idA = pm.collectionVariables.get(\"id_mueble\");",
              "var idB = pm.collectionVariables.get(\"id_mueble_2\");",
              "pm.test(\"Ya no esta el mueble A y sigue el mueble B\", function () {",
              "    pm.expect(carrito.cantidadItems).to.eql(1);",
              "    pm.expect(carrito.items.find(function (i) { return i.idMueble === idA; })).to.be.undefined;",
              "    pm.expect(carrito.items[0].idMueble).to.eql(idB);",
              "});",
              "pm.test(\"Total = subtotal del unico item restante (USD)\", function () {",
              "    pm.expect(carrito.totalUsd).to.be.closeTo(carrito.items[0].subtotalUsd, 0.001);",
              "    pm.expect(carrito.totalBs).to.be.closeTo(carrito.items[0].subtotalBs, 0.02);",
              "});",
              "pm.test(\"El CLIENTE no ve la cifra de stock\", function () {",
              "    pm.expect(carrito.items[0]).to.not.have.property(\"unidades\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
