    {
      "name": "4. Consultar catalogo (ADMIN) para elegir dos muebles con stock",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var conStock = pm.response.json().filter(function (m) { return m.unidades > 0; });",
              "pm.test(\"Hay al menos dos muebles con stock\", function () {",
              "    pm.expect(conStock.length).to.be.at.least(2);",
              "});",
              "pm.collectionVariables.set(\"id_mueble\", conStock[0].id);",
              "pm.collectionVariables.set(\"precio_mueble\", conStock[0].precioUsd);",
              "pm.collectionVariables.set(\"id_mueble_2\", conStock[1].id);",
              "pm.collectionVariables.set(\"precio_mueble_2\", conStock[1].precioUsd);"
            ],
            "type": "text/javascript"
          }
        }
