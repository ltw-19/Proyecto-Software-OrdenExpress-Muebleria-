    {
      "name": "1. Registrar CLIENTE A para la prueba",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Correo unico en cada corrida para que la coleccion se pueda repetir.",
              "pm.collectionVariables.set(\"correo_cliente\", \"pedido.cliente.\" + Date.now() + \"@ordenexpress.com\");"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cuentas/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cuentas",
            "registro"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Cliente\",\n  \"apellido\": \"Pedido\",\n  \"correo\": \"{{correo_cliente}}\",\n  \"clave\": \"Cliente123*\",\n  \"telefono\": \"04121234567\"\n}"
        }
      }
    },
    {
      "name": "2. Iniciar Sesion como CLIENTE A",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Token presente y rol CLIENTE\", function () {",
              "    pm.expect(jsonData.rol).to.eql(\"CLIENTE\");",
              "    pm.collectionVariables.set(\"token_cliente\", jsonData.token);",
              "});"
            ],
