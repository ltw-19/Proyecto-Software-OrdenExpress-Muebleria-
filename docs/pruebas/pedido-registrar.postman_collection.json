    {
      "name": "15. Registrar pedido (CLIENTE A) - 201, ignora montos enviados",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var p = pm.response.json();",
              "pm.collectionVariables.set(\"id_pedido\", p.id);",
              "pm.collectionVariables.set(\"numero_pedido\", p.numero);",
              "pm.test(\"Numero legible OE-#### y estado PENDIENTE\", function () {",
              "    pm.expect(p.numero).to.match(/^OE-\\d{4,}$/);",
              "    pm.expect(p.estado).to.eql(\"PENDIENTE\");",
              "    pm.expect(p.id).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(p.timestamp).to.be.a(\"string\").and.not.empty;",
              "});",
              "pm.test(\"Dos items con cantidad 1\", function () {",
              "    pm.expect(p.items.length).to.eql(2);",
              "    p.items.forEach(function (i) { pm.expect(i.cantidad).to.eql(1); });",
              "});",
              "pm.test(\"Total USD sale de muebles.json, no del cuerpo (0.01 ignorado)\", function () {",
              "    var esperado = Number(pm.collectionVariables.get(\"precio_mueble\")) + Number(pm.collectionVariables.get(\"precio_mueble_2\"));",
              "    pm.expect(Number(p.totalUsd)).to.be.closeTo(esperado, 0.001);",
              "    pm.expect(Number(p.totalUsd)).to.not.eql(0.01);",
              "});",
              "pm.test(\"Total Bs = total USD x tasa congelada (2 decimales)\", function () {",
              "    var esperadoBs = Math.round(Number(p.totalUsd) * Number(p.tasaBcv) * 100) / 100;",
              "    pm.expect(Number(p.totalBs)).to.be.closeTo(esperadoBs, 0.001);",
              "    pm.expect(Number(p.tasaBcv)).to.be.above(0);",
              "});",
              "pm.test(\"Datos de entrega guardados\", function () {",
              "    pm.expect(p.entrega.nombre).to.eql(\"Cliente\");",
              "    pm.expect(p.entrega.telefono).to.eql(\"04121234567\");",
              "});",
              "pm.test(\"Enlace de WhatsApp pre-estructurado con el numero del pedido\", function () {",
              "    pm.expect(p.enlaceWhatsapp).to.match(/^https:\\/\\/wa\\.me\\/[0-9]+\\?text=/);",
              "    pm.expect(decodeURIComponent(p.enlaceWhatsapp)).to.include(p.numero);",
              "});",
              "pm.test(\"El cliente no recibe la cifra de stock\", function () {",
              "    p.items.forEach(function (i) { pm.expect(i).to.not.have.property(\"unidades\"); });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
